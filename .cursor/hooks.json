{
  "version": 1,
  "hooks": {
    "sessionStart": [
      {
        "command": "node cli/src/index.ts ingest cursor sessionStart"
      }
    ],
    "sessionEnd": [
      {
        "command": "node cli/src/index.ts ingest cursor sessionEnd"
      }
    ],
    "beforeSubmitPrompt": [
      {
        "command": "node cli/src/index.ts ingest cursor beforeSubmitPrompt"
      }
    ],
    "stop": [
      {
        "command": "node cli/src/index.ts ingest cursor stop"
      }
    ]
  }
}
