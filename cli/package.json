{
  "name": "cli-node",
  "description": "CLI for Node.js archetype project",
  "version": "0.8.1",
  "private": true,
  "type": "module",
  "license": "MIT",
  "bin": {
    "cli-node": "src/index.ts"
  },
  "scripts": {
    "start": "bun src/index.ts",
    "dev": "bun --watch src/index.ts",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "build": "bun build src/index.ts --target=node --format=esm --outfile=../.agents/hooks/index.mjs",
    "compile": "bun scripts/compile.ts",
    "compile:all": "bun scripts/compile.ts --all",
    "test": "node --test test/*.test.ts",
    "lint": "oxlint -c .oxlint.json --format=agent --quiet src scripts"
  },
  "dependencies": {},
  "devDependencies": {
    "@types/node": "^26.4.0",
    "oxlint": "^1.80.0",
    "oxlint-tsgolint": "^7.0.2001",
    "typescript": "^7.0.2"
  },
  "packageManager": "bun@1.4.0",
  "engines": {
    "node": ">=24.0.0",
    "bun": ">=1.4.0"
  }
}